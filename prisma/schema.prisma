datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  COACH
  AD_HOC_COACH
  PLAYER
  PARENT
}

enum AccountStatus {
  ACTIVE
  INVITED
  LOCKED
  DEACTIVATED
}

enum BattingPosition {
  OPENING_BATTER
  TOP_ORDER
  MIDDLE_ORDER
  FINISHER
  TAILENDER
}

enum BowlingStyle {
  RIGHT_ARM_FAST
  RIGHT_ARM_MEDIUM
  LEFT_ARM_FAST
  LEFT_ARM_MEDIUM
  OFF_SPIN
  LEG_SPIN
  LEFT_ARM_ORTHODOX
  LEFT_ARM_WRIST_SPIN
  DOES_NOT_BOWL
}

enum SecondaryRole {
  WICKETKEEPER
  ALL_ROUNDER
}

enum ApparelSize {
  YOUTH_XXS
  YOUTH_XS
  YOUTH_S
  YOUTH_M
  YOUTH_L
  YOUTH_XL
  ADULT_S
  ADULT_M
  ADULT_L
  ADULT_XL
  ADULT_XXL
  ADULT_XXXL
}

model MemberProfile {
  id              String            @id @default(uuid())
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  email           String?           @unique
  phone           String?
  address         String?
  city            String?
  postalCode      String?
  battingPosition BattingPosition?
  bowlingStyle    BowlingStyle?
  secondaryRoles  SecondaryRole[]
  shirtSize       ApparelSize?
  trouserSize     ApparelSize?
  capSize         ApparelSize?
  isAnonymized    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  userAccount       UserAccount?
  roleAssignments   RoleAssignment[]
  parentLinksAsParent ParentChildLink[]  @relation("ParentLinks")
  parentLinksAsPlayer ParentChildLink[]  @relation("PlayerLinks")
  emergencyContacts EmergencyContact[]
  privacySettings   PrivacySettings?
  consentsGiven     ConsentRecord[]      @relation("ConsentedBy")
  consentsReceived  ConsentRecord[]      @relation("SubjectProfile")
  actionsPerformed  AuditLog[]           @relation("AuditActor")
  actionsTargeted   AuditLog[]           @relation("AuditTarget")

  // Module 2: Inventory & Equipment Relations
  borrowedEquipment       EquipmentLoan[]          @relation("BorrowerLoans")
  issuedEquipment         EquipmentLoan[]          @relation("IssuedLoans")
  receivedEquipment       EquipmentLoan[]          @relation("ReceivedLoans")
  receivedStock           StockTransaction[]       @relation("StockRecipients")
  recordedStock           StockTransaction[]       @relation("StockRecorders")
  requestedExtensions     EquipmentLoanExtension[] @relation("ExtensionRequesters")
  reviewedExtensions      EquipmentLoanExtension[] @relation("ExtensionReviewers")
  reportedEquipmentDamage EquipmentDamageReport[]  @relation("DamageReporters")
  resolvedEquipmentDamage EquipmentDamageReport[]  @relation("DamageResolvers")

  // Module 3: Teams, Squads, Training & Match Scheduling Relations
  coachAssignments        TeamCoachAssignment[]
  rosterMemberships       TeamRosterMember[]
  eventsCreated           ScheduledEvent[]          @relation("EventCreators")
  eventCollisionOverrides ScheduledEvent[]          @relation("EventCollisionOverrides")
  rsvps                   EventRsvp[]               @relation("MemberRsvps")
  rsvpsSubmitted          EventRsvp[]               @relation("RsvpSubmitters")
  publishedLineups        MatchSelection[]          @relation("LineupPublishers")
  matchSelections         MatchSelectionPlayer[]    @relation("SelectedMatchPlayers")
  attendances             EventAttendance[]         @relation("MemberAttendances")
  attendancesRecorded     EventAttendance[]         @relation("AttendanceRecorders")
}

model UserAccount {
  id                         String        @id @default(uuid())
  memberProfileId            String        @unique
  email                      String        @unique
  passwordHash               String
  status                     AccountStatus @default(INVITED)
  mustResetPassword          Boolean       @default(true)
  temporaryPasswordExpiresAt DateTime?
  failedLoginAttempts        Int           @default(0)
  lockedUntil                DateTime?
  sessionVersion             Int           @default(1)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  memberProfile       MemberProfile        @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model RoleAssignment {
  id              String        @id @default(uuid())
  memberProfileId String
  role            Role
  assignedAt      DateTime      @default(now())
  assignedById    String?

  memberProfile MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@unique([memberProfileId, role])
}

model ParentChildLink {
  id           String        @id @default(uuid())
  playerId     String
  parentId     String
  slot         Int
  relationship String?
  createdAt    DateTime      @default(now())

  player MemberProfile @relation("PlayerLinks", fields: [playerId], references: [id], onDelete: Cascade)
  parent MemberProfile @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([playerId, slot])
  @@unique([playerId, parentId])
}

model Session {
  id            String      @id @default(uuid())
  sessionToken  String      @unique
  userAccountId String
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id            String      @id @default(uuid())
  token         String      @unique
  userAccountId String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id              String        @id @default(uuid())
  memberProfileId String
  name            String
  relationship    String
  phone           String
  isPrimary       Boolean       @default(true)

  memberProfile MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
}

model PrivacySettings {
  id                     String        @id @default(uuid())
  memberProfileId        String        @unique
  showEmailInDirectory   Boolean       @default(false)
  showPhoneInDirectory   Boolean       @default(false)
  showAddressInDirectory Boolean       @default(false)

  memberProfile MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id               String        @id @default(uuid())
  subjectProfileId String
  consentedById    String
  policyVersion    String
  consentedAt      DateTime      @default(now())
  ipAddress        String?

  subjectProfile MemberProfile @relation("SubjectProfile", fields: [subjectProfileId], references: [id], onDelete: Cascade)
  consentedBy    MemberProfile @relation("ConsentedBy", fields: [consentedById], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              String         @id @default(uuid())
  actorProfileId  String?
  targetProfileId String?
  action          String
  metadata        Json?
  createdAt       DateTime       @default(now())

  actorProfile  MemberProfile? @relation("AuditActor", fields: [actorProfileId], references: [id], onDelete: SetNull)
  targetProfile MemberProfile? @relation("AuditTarget", fields: [targetProfileId], references: [id], onDelete: SetNull)
}

// ==========================================
// MODULE 2: INVENTORY & EQUIPMENT ENUMS
// ==========================================

enum TrackingType {
  SERIALIZED
  BULK
}

enum EquipmentCategory {
  BATTING
  PROTECTIVE
  BOWLING_BALLS
  TRAINING_GROUND
  FACILITY_KEYS
  APPAREL_KIT
}

enum AgeGroup {
  JUNIOR
  YOUTH
  SENIOR
  UNIVERSAL
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  NEEDS_REPAIR
  RETIRED
}

enum ItemStatus {
  AVAILABLE
  ON_LOAN
  UNDER_MAINTENANCE
  RETIRED
}

enum LoanStatus {
  ACTIVE
  OVERDUE
  RETURNED
  LOST
}

enum StockTransactionType {
  CONSUMPTION
  TEMPORARY_LOAN
  RETURN_RESTOCK
  REPLENISHMENT
  AUDIT_CORRECTION
  WRITE_OFF
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DamageReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// ==========================================
// MODULE 2: INVENTORY & EQUIPMENT MODELS
// ==========================================

model EquipmentItem {
  id                      String            @id @default(uuid())
  assetTag                String?           @unique
  name                    String
  description             String?
  trackingType            TrackingType      @default(SERIALIZED)
  category                EquipmentCategory
  ageGroup                AgeGroup          @default(UNIVERSAL)
  condition               ItemCondition     @default(GOOD)
  status                  ItemStatus        @default(AVAILABLE)
  storageLocation         String
  totalQuantity           Int               @default(1)
  availableQuantity       Int               @default(1)
  lowStockThreshold       Int?
  purchasePriceMinorUnits Int?              // Stored in integer øre (DKK), e.g. 129900 = 1,299.00 DKK
  acquisitionDate         DateTime?
  warrantyExpiresAt       DateTime?
  isRetired               Boolean           @default(false)
  retiredReason           String?
  retiredAt               DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  loans             EquipmentLoan[]
  stockTransactions StockTransaction[]
  damageReports     EquipmentDamageReport[]

  @@index([category, status])
  @@index([storageLocation])
  @@index([trackingType])
}

model EquipmentLoan {
  id                 String         @id @default(uuid())
  equipmentItemId    String
  borrowerProfileId  String
  quantity           Int            @default(1)
  teamOrSquadName    String?
  status             LoanStatus     @default(ACTIVE)
  issuedById         String
  checkedOutAt       DateTime       @default(now())
  expectedReturnAt   DateTime
  checkoutCondition  ItemCondition
  checkoutNotes      String?
  returnedAt         DateTime?
  receivedById       String?
  returnCondition    ItemCondition?
  returnNotes        String?
  lastReminderSentAt DateTime?      // For 24-hour reminder cooldown guard
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  equipmentItem   EquipmentItem            @relation(fields: [equipmentItemId], references: [id], onDelete: Restrict)
  borrowerProfile MemberProfile            @relation("BorrowerLoans", fields: [borrowerProfileId], references: [id], onDelete: Restrict)
  issuedBy        MemberProfile            @relation("IssuedLoans", fields: [issuedById], references: [id], onDelete: Restrict)
  receivedBy      MemberProfile?           @relation("ReceivedLoans", fields: [receivedById], references: [id], onDelete: SetNull)
  extensions      EquipmentLoanExtension[]
  damageReports   EquipmentDamageReport[]
  linkedEvents    ScheduledEvent[]         @relation("EventKitLoans")

  @@index([borrowerProfileId, status])
  @@index([equipmentItemId, status])
  @@index([expectedReturnAt, status])
}

model StockTransaction {
  id                     String               @id @default(uuid())
  equipmentItemId        String
  transactionType        StockTransactionType
  quantityDelta          Int
  totalQuantityAfter     Int
  availableQuantityAfter Int
  recipientProfileId     String?
  teamOrSquadName        String?
  reason                 String?
  recordedById           String
  createdAt              DateTime             @default(now())

  equipmentItem    EquipmentItem  @relation(fields: [equipmentItemId], references: [id], onDelete: Restrict)
  recipientProfile MemberProfile? @relation("StockRecipients", fields: [recipientProfileId], references: [id], onDelete: SetNull)
  recordedBy       MemberProfile  @relation("StockRecorders", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([equipmentItemId, transactionType])
  @@index([createdAt])
}

model EquipmentLoanExtension {
  id               String          @id @default(uuid())
  loanId           String
  requestedById    String
  proposedReturnAt DateTime
  reason           String
  status           ExtensionStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  loan        EquipmentLoan  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  requestedBy MemberProfile  @relation("ExtensionRequesters", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  MemberProfile? @relation("ExtensionReviewers", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([loanId, status])
}

model EquipmentDamageReport {
  id              String             @id @default(uuid())
  equipmentItemId String
  equipmentLoanId String?
  reportedById    String
  severity        String             // "MINOR" | "MAJOR" | "BEYOND_REPAIR" | "LOST"
  description     String
  status          DamageReportStatus @default(PENDING)
  resolutionNotes String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  equipmentItem EquipmentItem  @relation(fields: [equipmentItemId], references: [id], onDelete: Restrict)
  loan          EquipmentLoan? @relation(fields: [equipmentLoanId], references: [id], onDelete: SetNull)
  reportedBy    MemberProfile  @relation("DamageReporters", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy    MemberProfile? @relation("DamageResolvers", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([equipmentItemId, status])
  @@index([reportedById])
}

// =======================================================
// MODULE 3: TEAMS, SQUADS, TRAINING & MATCH SCHEDULING
// =======================================================

enum SquadCategory {
  SENIOR
  YOUTH
  SOCIAL
}

enum SquadStaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  AD_HOC_COACH
}

enum RosterRole {
  PLAYER
  CAPTAIN
  VICE_CAPTAIN
}

enum FacilityType {
  MAIN_PITCH
  PRACTICE_NETS
  INDOOR_HALL
  CLUBHOUSE
}

enum EventType {
  MATCH
  TRAINING
}

enum MatchType {
  LEAGUE
  FRIENDLY
  CUP
  TOURNAMENT
}

enum TrainingType {
  NET_PRACTICE
  FIELDING_FITNESS
  INDOOR_WINTER
  OPEN_NETS
}

enum EventLifecycleStatus {
  SCHEDULED
  PLAYED
  RAINED_OUT
  CANCELLED
}

enum RsvpStatus {
  NO_RESPONSE
  AVAILABLE
  UNAVAILABLE
  MAYBE
}

enum SelectionPublicationStatus {
  DRAFT
  PUBLISHED
}

enum LineupSlot {
  STARTING
  SUBSTITUTE
  RESERVE
}

enum MatchTacticalRole {
  PLAYER
  CAPTAIN
  VICE_CAPTAIN
  WICKETKEEPER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT_EXCUSED
  NO_SHOW
}

model TeamSquad {
  id                String                @id @default(uuid())
  name              String                @unique
  category          SquadCategory
  ageGroupRule      String?               // "U13", "U15", "U17", "OPEN"
  defaultLineupSize Int                   @default(11)
  genderGroup       String                @default("MIXED") // "MENS", "WOMENS", "MIXED"
  description       String?
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  coachAssignments  TeamCoachAssignment[]
  roster            TeamRosterMember[]
  scheduledEvents   ScheduledEvent[]

  @@index([category, isActive])
}

model TeamCoachAssignment {
  id             String         @id @default(uuid())
  teamSquadId    String
  coachProfileId String
  role           SquadStaffRole @default(HEAD_COACH)
  assignedAt     DateTime       @default(now())

  teamSquad    TeamSquad     @relation(fields: [teamSquadId], references: [id], onDelete: Cascade)
  coachProfile MemberProfile @relation(fields: [coachProfileId], references: [id], onDelete: Restrict)

  @@unique([teamSquadId, coachProfileId])
  @@index([coachProfileId])
}

model TeamRosterMember {
  id                String        @id @default(uuid())
  teamSquadId       String
  memberProfileId   String
  rosterRole        RosterRole    @default(PLAYER)
  jerseyNumber      Int?
  hasDispensation   Boolean       @default(false)
  dispensationNotes String?
  joinedAt          DateTime      @default(now())
  isActive          Boolean       @default(true)

  teamSquad     TeamSquad     @relation(fields: [teamSquadId], references: [id], onDelete: Cascade)
  memberProfile MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Restrict)

  @@unique([teamSquadId, memberProfileId])
  @@index([memberProfileId, isActive])
}

model ClubFacility {
  id           String       @id @default(uuid())
  name         String       @unique
  facilityType FacilityType
  location     String?
  capacity     Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  scheduledEvents ScheduledEvent[]

  @@index([facilityType, isActive])
}

model ScheduledEvent {
  id                      String               @id @default(uuid())
  teamSquadId             String
  facilityId              String?
  eventType               EventType
  matchType               MatchType?
  trainingType            TrainingType?
  title                   String
  date                    DateTime
  meetAt                  DateTime?
  startAt                 DateTime
  endAt                   DateTime
  isHome                  Boolean              @default(true)
  opponentName            String?
  venueName               String?
  venueAddress            String?
  rsvpDeadlineAt          DateTime
  targetLineupSize        Int                  @default(11)
  lifecycleStatus         EventLifecycleStatus @default(SCHEDULED)
  scorecardUrl            String?
  collisionOverrideById   String?
  collisionOverrideReason String?
  collisionOverrideAt     DateTime?
  linkedEquipmentLoanId   String?
  createdById             String
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  teamSquad           TeamSquad         @relation(fields: [teamSquadId], references: [id], onDelete: Restrict)
  facility            ClubFacility?     @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  collisionOverrideBy MemberProfile?    @relation("EventCollisionOverrides", fields: [collisionOverrideById], references: [id], onDelete: SetNull)
  createdBy           MemberProfile     @relation("EventCreators", fields: [createdById], references: [id], onDelete: Restrict)
  linkedEquipmentLoan EquipmentLoan?    @relation("EventKitLoans", fields: [linkedEquipmentLoanId], references: [id], onDelete: SetNull)

  rsvps          EventRsvp[]
  matchSelection MatchSelection?
  attendances    EventAttendance[]

  @@index([facilityId, startAt, endAt])
  @@index([teamSquadId, date])
  @@index([startAt, lifecycleStatus])
}

model EventRsvp {
  id               String         @id @default(uuid())
  scheduledEventId String
  memberProfileId  String
  submittedById    String
  status           RsvpStatus     @default(NO_RESPONSE)
  transportNote    String?
  submittedAt      DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  scheduledEvent ScheduledEvent @relation(fields: [scheduledEventId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile  @relation("MemberRsvps", fields: [memberProfileId], references: [id], onDelete: Restrict)
  submittedBy    MemberProfile  @relation("RsvpSubmitters", fields: [submittedById], references: [id], onDelete: Restrict)

  @@unique([scheduledEventId, memberProfileId])
  @@index([memberProfileId, status])
}

model MatchSelection {
  id               String                     @id @default(uuid())
  scheduledEventId String                     @unique
  selectionStatus  SelectionPublicationStatus @default(DRAFT)
  targetLineupSize Int                        @default(11)
  publishedAt      DateTime?
  publishedById    String?
  notes            String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  scheduledEvent  ScheduledEvent         @relation(fields: [scheduledEventId], references: [id], onDelete: Cascade)
  publishedBy     MemberProfile?         @relation("LineupPublishers", fields: [publishedById], references: [id], onDelete: SetNull)
  selectedPlayers MatchSelectionPlayer[]

  @@index([selectionStatus])
}

model MatchSelectionPlayer {
  id                   String            @id @default(uuid())
  matchSelectionId     String
  memberProfileId      String
  selectionRole        LineupSlot        @default(STARTING)
  tacticalRole         MatchTacticalRole @default(PLAYER)
  battingOrderPosition Int?
  createdAt            DateTime          @default(now())

  matchSelection MatchSelection @relation(fields: [matchSelectionId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile  @relation("SelectedMatchPlayers", fields: [memberProfileId], references: [id], onDelete: Restrict)

  @@unique([matchSelectionId, memberProfileId])
  @@index([memberProfileId])
}

model EventAttendance {
  id               String           @id @default(uuid())
  scheduledEventId String
  memberProfileId  String
  status           AttendanceStatus @default(PRESENT)
  arrivalTime      DateTime?
  notes            String?
  recordedById     String
  recordedAt       DateTime         @default(now())
  isLocked         Boolean          @default(false)
  lockedAt         DateTime?

  scheduledEvent ScheduledEvent @relation(fields: [scheduledEventId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile  @relation("MemberAttendances", fields: [memberProfileId], references: [id], onDelete: Restrict)
  recordedBy     MemberProfile  @relation("AttendanceRecorders", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([scheduledEventId, memberProfileId])
  @@index([memberProfileId, status])
  @@index([scheduledEventId, isLocked])
}
